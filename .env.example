# 将此文件复制为 .env，API Key 只保存在服务端，不要提交进 Git
DASHSCOPE_API_KEY=
# 阿里云百炼控制台中的 WorkspaceId，请与 API Key 区域匹配
# 北京示例: https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/images/generations
QWEN_IMAGE_ENDPOINT=
QWEN_IMAGE_MODEL=qwen-image-3.0
# macOS 示例（如存在）: /System/Library/Fonts/PingFang.ttc
# Linux 示例: /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
POSTER_FONT_PATH=
POSTER_DATA_DIR=data/posters

# M2: Qwen Brief 结构化编译；与图片接口使用相同区域的 Workspace ID
QWEN_CHAT_ENDPOINT=
QWEN_CHAT_MODEL=qwen-plus

# M2b 单机 LangGraph SQLite 持久化检查点（勿提交数据库文件）
POSTER_CHECKPOINT_DB=data/checkpoints.sqlite3

# M2c 本地幂等请求 + 执行事件数据库
POSTER_EXECUTION_DB=data/executions.sqlite3
